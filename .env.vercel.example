# This file documents the environment variables required for Vercel deployment
# Add these in Vercel Settings > Environment Variables > Production

# Database Connection
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Groq API Key
GROQ_API_KEY=gsk_xxxx

# Public Groq API Key (can be exposed)
NEXT_PUBLIC_GROQ_API_KEY=gsk_xxxx
